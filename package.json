{
  "name": "personal-website",
  "version": "0.1.0",
  "description": "Personal website of Marcos Lima (skvggor) with a Japanese constructivist おまかせ (omakase) poster aesthetic.",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "dev": "next dev --turbopack",
    "build": "npm run type-check && next build",
    "start": "next start",
    "lint": "biome check .",
    "update-screenshot": "docker build -f scripts/Dockerfile.screenshot -t personal-website-screenshot . && docker run --rm -e SITE_DOMAIN=\"${SITE_DOMAIN:-skvggor}\" --env-file .env -v \"$(pwd)/public:/app/public\" personal-website-screenshot"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "motion": "^13.0.0",
    "next": "^16.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "puppeteer": "^25.5.0",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
